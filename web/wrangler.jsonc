{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scowld-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "scowld.xyz",
      "custom_domain": true
    },
    {
      "pattern": "www.scowld.xyz",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": false
  }
}
