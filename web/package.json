{
  "name": "scowld-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/check-site.js",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint --max-warnings=0 && html-validate --max-warnings=0 \"public/**/*.html\"",
    "test": "vitest run",
    "smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "fast-check": "4.10.2",
    "fast-xml-parser": "5.11.2",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "vitest": "5.0.5",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261012.1": true
  }
}
