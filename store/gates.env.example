# Copy these names into GitHub → Settings → Secrets and variables → Actions → Variables.
# Missing or false = off. Values other than true/false/yes/no/on/off/1/0 fail the run,
# even when IOS_RELEASE_AUTOMATION is off. See store/README.md.

# --- iOS (v* tags; .github/workflows/ios-release.yml) ---
# Master switch: when off, no iOS store operation runs (the tests still run and the
# GitHub Release is still created).
IOS_RELEASE_AUTOMATION=false
# Build, sign and upload the binary to App Store Connect, then wait until it is processed.
IOS_UPLOAD_BUILD=false
# App name, subtitle, privacy URL, description, keywords, promotional text, marketing/support URLs.
IOS_UPLOAD_LISTING=false
# What's New text (store/metadata/ios/<locale>/whats_new.txt).
IOS_UPLOAD_WHATS_NEW=false
# Screenshots listed in store/metadata/ios/<locale>/screenshots.json.
IOS_UPLOAD_SCREENSHOTS=false
# Select this run's processed build and submit for App Review (needs IOS_UPLOAD_BUILD).
IOS_SUBMIT_REVIEW=false
# true = release automatically after approval; false = you release it by hand.
IOS_PUBLIC_RELEASE=false
# Build readiness polling (defaults shown).
IOS_BUILD_POLL_SECONDS=30
IOS_BUILD_WAIT_MINUTES=120
